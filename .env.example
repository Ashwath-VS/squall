# Squall environment — copy to .env for local dev (root of repo)

# LLM (OpenAI-compatible). DeepSeek by default — same as AirWave.
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat

# Live data — SerpAPI (flights + news). Weather + traffic are keyless.
SERPAPI_KEY=your-serpapi-key

# Optional
CACHE_TTL=900
FLASK_DEBUG=True
